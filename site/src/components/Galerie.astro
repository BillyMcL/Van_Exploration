---
/**
 * Grille d'une série publiée.
 *
 * Les dérivés sont lus sur le disque au build — AVIF, WebP et JPEG produits par
 * la chaîne de traitement du dépôt privé, débarrassés de leurs métadonnées. Le
 * navigateur choisit le format qu'il sait lire ; le JPEG reste le repli.
 *
 * Aucune image n'est chargée avant d'entrer dans le champ, et chacune porte ses
 * dimensions : une galerie ne doit pas faire sauter la mise en page pendant
 * qu'elle se remplit, ni tirer plusieurs mégaoctets sur une connexion cellulaire.
 */
import { readdirSync, existsSync, readFileSync } from 'node:fs';
import { fileURLToPath } from 'node:url';
import { join, extname, basename } from 'node:path';

interface Props { famille: string; serie: string; legende?: string; }
const { famille, serie, legende } = Astro.props;

/**
 * Dimensions lues dans l'en-tête JPEG, sans dépendance.
 *
 * Le site n'a besoin que de la largeur et de la hauteur, pour réserver la place
 * de chaque image avant son chargement. Tirer une bibliothèque de traitement
 * d'images native dans le dépôt public pour lire deux entiers serait payer très
 * cher un segment de quatre octets.
 */
function dimensionsJpeg(chemin: string): { largeur: number; hauteur: number } | null {
  const buf = readFileSync(chemin);
  if (buf.length < 4 || buf[0] !== 0xff || buf[1] !== 0xd8) return null;
  let i = 2;
  while (i + 9 < buf.length) {
    if (buf[i] !== 0xff) { i++; continue; }
    const marqueur = buf[i + 1];
    // SOFn porte les dimensions, sauf 0xC4 (Huffman), 0xC8 (extension) et 0xCC (arithmétique).
    if (marqueur >= 0xc0 && marqueur <= 0xcf && ![0xc4, 0xc8, 0xcc].includes(marqueur)) {
      return { hauteur: buf.readUInt16BE(i + 5), largeur: buf.readUInt16BE(i + 7) };
    }
    if (marqueur === 0xd8 || marqueur === 0x01 || (marqueur >= 0xd0 && marqueur <= 0xd7)) { i += 2; continue; }
    i += 2 + buf.readUInt16BE(i + 2);
  }
  return null;
}

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const dossier = fileURLToPath(new URL(`../../../media/${famille}/${serie}/`, import.meta.url));

const noms = existsSync(dossier)
  ? [...new Set(readdirSync(dossier)
      .filter((f) => ['.avif', '.webp', '.jpg'].includes(extname(f).toLowerCase()))
      .map((f) => basename(f, extname(f))))].sort()
  : [];

const images = noms.map((nom) => {
  const jpg = join(dossier, `${nom}.jpg`);
  // Pas de dimensions de repli inventées : une valeur choisie au hasard
  // décalerait la mise en page au lieu de la réserver, et un nombre écrit à la
  // main dans un fichier public finit tôt ou tard par coïncider avec une donnée
  // privée — le garde-fou a refusé la première tentative pour cette raison.
  const taille = existsSync(jpg) ? dimensionsJpeg(jpg) : null;
  return {
    nom,
    largeur: taille?.largeur,
    hauteur: taille?.hauteur,
    src: `${base}/media/${famille}/${serie}/${nom}`,
    disponible: {
      avif: existsSync(join(dossier, `${nom}.avif`)),
      webp: existsSync(join(dossier, `${nom}.webp`)),
    },
  };
});
---

{images.length > 0 && (
  <figure class="galerie">
    <div class="grille">
      {images.map((i) => (
        <picture>
          {i.disponible.avif && <source srcset={`${i.src}.avif`} type="image/avif" />}
          {i.disponible.webp && <source srcset={`${i.src}.webp`} type="image/webp" />}
          <img
            src={`${i.src}.jpg`}
            width={i.largeur ?? undefined}
            height={i.hauteur ?? undefined}
            loading="lazy"
            decoding="async"
            alt={legende ? `${legende} — ${i.nom}` : i.nom}
          />
        </picture>
      ))}
    </div>
    {legende && <figcaption>{legende}</figcaption>}
  </figure>
)}

<style>
  .galerie { margin: 1.25rem 0 0; }
  .grille { display: grid; grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr)); gap: 0.5rem; }
  .grille img { width: 100%; height: auto; display: block; background: var(--appui); }
  figcaption { margin-top: 0.75rem; font-size: 0.9rem; color: var(--attenue); }
</style>
