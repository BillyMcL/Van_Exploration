---
/**
 * Carte des pays traversés.
 *
 * Des marqueurs, jamais un tracé. Relier les points donnerait un ordre de
 * passage, donc un calendrier, donc la position future du véhicule. Le schéma de
 * `donnees.ts` refuse toute géométrie autre que Point : la contrainte casse le
 * build, elle ne repose pas sur la mémoire de celui qui édite le fichier.
 *
 * Les données sont sérialisées au build dans une balise JSON et relues côté
 * client. Sans JavaScript, la liste des pays reste lisible dans le `noscript`.
 */
import { paysTraverses } from '../lib/donnees';

const pays = paysTraverses.features.map((f) => ({
  nom: f.properties.pays,
  coord: f.geometry.coordinates,
}));
---

<figure class="carte">
  <div id="carte" role="img" aria-label={`Carte des ${pays.length} pays traversés`}></div>

  <script type="application/json" id="donnees-carte" set:html={JSON.stringify(pays)}></script>

  <noscript>
    <ul class="carte-repli">
      {pays.map((p) => <li>{p.nom}</li>)}
    </ul>
  </noscript>

  <figcaption>
    Pays traversés — <strong>ordre et dates non publiés</strong>.
    L'itinéraire détaillé n'est diffusé qu'en rétrospective, après le passage.
  </figcaption>
</figure>

<style>
  .carte { margin: 0; }
  #carte { height: 32rem; border: 1px solid currentColor; }
  figcaption { margin-top: 0.75rem; font-size: 0.9rem; opacity: 0.8; }
  .carte-repli { columns: 3; margin: 0; padding-left: 1.2rem; }
  @media (max-width: 40rem) {
    #carte { height: 24rem; }
    .carte-repli { columns: 2; }
  }
</style>

<script>
  import L from 'leaflet';
  import 'leaflet/dist/leaflet.css';

  type Pays = { nom: string; coord: [number, number] };

  const brut = document.getElementById('donnees-carte')?.textContent;
  const conteneur = document.getElementById('carte');
  if (brut && conteneur) {
    const pays: Pays[] = JSON.parse(brut);

    const carte = L.map(conteneur, { scrollWheelZoom: false });

    L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
      maxZoom: 8,
      attribution: '&copy; contributeurs <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
    }).addTo(carte);

    // Marqueurs vectoriels : pas d'image à charger, donc pas d'icône cassée par
    // le bundler, et le rendu suit la couleur du texte en thème clair ou sombre.
    const points = pays.map(({ nom, coord: [lon, lat] }) =>
      L.circleMarker([lat, lon], {
        radius: 9,
        weight: 2,
        color: 'currentColor',
        fillOpacity: 0.25,
      })
        .bindTooltip(nom, { permanent: false, direction: 'top' })
        .addTo(carte),
    );

    // Aucun L.polyline ici, et il ne doit jamais y en avoir : voir le
    // commentaire d'en-tête et le schéma dans src/lib/donnees.ts.
    carte.fitBounds(L.featureGroup(points).getBounds(), { padding: [40, 40] });
  }
</script>
